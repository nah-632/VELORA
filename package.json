{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc -p tsconfig.check.json --noEmit",
    "test": "node --import tsx --test \"tests/unit/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\"",
    "test:db": "node scripts/db-replay.mjs && node tests/db/isolation.mjs && node tests/db/catalogue.mjs && node tests/db/drafts.mjs",
    "test:db:operator": "node tests/db/operator-schema.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:fonts": "python3 scripts/check-fonts.py",
    "test:brand": "node tests/ui/check-brand.mjs",
    "fonts:build": "python3 scripts/fonts.py",
    "brand:build": "python3 scripts/build-wordmark.py && node scripts/build-brand.mjs",
    "wordmark:build": "python3 scripts/build-wordmark.py",
    "test:ui": "python3 scripts/check-contrast.py && node scripts/check-rtl.mjs && node scripts/check-css.mjs && node tests/ui/check-renderer.mjs && node tests/ui/guard-canary.mjs",
    "verify": "npm run check:native && npm run type-check && npm run test && npm run test:db:operator && npm run test:db:auth && npm run test:db:invitations && npm run test:fonts && npm run test:brand && npm run test:ui",
    "db:status": "node scripts/db-migrate.mjs --status",
    "test:db:auth": "node --import tsx tests/db/admin-auth.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "check:native": "node scripts/check-native-deps.mjs",
    "test:db:invitations": "node --import tsx tests/db/invitations.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "next": "14.2.35",
    "next-intl": "3.26.3",
    "postgres": "^3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}

# VELORA — environment template
# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Public — exposed to the browser, safe by design (an anon key is not a secret).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server only — must never be prefixed NEXT_PUBLIC_ and never reach the client.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string, used by migration and test tooling.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Payments — NO PROVIDER HAS BEEN SELECTED.
# Phase 1 ships a provider abstraction plus manual transaction recording.
# These stay empty until the owner selects a gateway; nothing is simulated.
# See docs/payments.md for exactly what is required to activate each one.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

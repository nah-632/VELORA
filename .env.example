# VELORA — environment template
# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# On CranL these live in the application's Environment tab. None of them belongs in the repository.

# ---------------------------------------------------------------------------
# Public — reaches the browser.
# ---------------------------------------------------------------------------
# Absolute URLs appear in Open Graph tags and in the WhatsApp message templates. It is not derived
# from the request host on purpose: a link built from a header can be made to point elsewhere.
NEXT_PUBLIC_SITE_URL=https://velora-lnurqz.cranl.net

# ---------------------------------------------------------------------------
# Server only — must never be prefixed NEXT_PUBLIC_ and must never reach the client.
# ---------------------------------------------------------------------------
# Injected automatically by CranL when the managed database is connected to the application.
# `scripts/db-migrate.mjs` refuses to run without it rather than reporting success on nothing.
DATABASE_URL=

# Peppers the hashes of the IP addresses stored with sign-in attempts. An IP address is personal
# data, and a table of the operator's login addresses should not be readable from a dump.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Used once, by scripts/seed-admin.mjs, to create the single administrator.
# There is no public sign-up and no route that creates an account.
#
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a long passphrase' npm run seed:admin
#
# Rotating a lost password is the same command with --reset, which also revokes every live session.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# Shared secret for scheduled work. Unused while the cron jobs run as shell commands inside the
# container; retained for any job that later needs to call an HTTP route.
CRON_SECRET=
# Set to 1 to make /api/health include the sanitized driver message in its response. Diagnosis
# only: leave it unset in normal operation.
HEALTH_VERBOSE=
